# ds1_lift manifest: per-binary overrides for DungeonSiege.exe
# (GOG 1.11.1.1486, SHA-256 41f14b14...938a02). Line based:
#
#   entry <hexva> [name]   extra function entry point
#   name  <hexva> <name>   name a function (comments in generated code)
#   probe <hexva> [name]   call ds1::Probe() on entry (runtime logs it)
#   resume <hexva>         this call/jmp abandons the current call chain
#                          (SEH): throw GuestResume to the owning frame
#   replace <hexva> [name] src/ defines f_<VA>; the lifted body becomes
#                          f_<VA>_lifted
#
# Addresses are guest VAs in hex, no 0x prefix needed.

name  004023DD WinMain
probe 004023DD WinMain

# SEH: __except_handler3 (0040A020) *calls* the __except block, which starts
# with `mov esp, [ebp-18h]` and never returns. Resume instead of calling.
name   0040A020 __except_handler3
name   00409F28 _global_unwind2
resume 0040A0A3

# Hor+ field of view (src/fov.cpp): the camera update, the drag-selection
# volume and mouse picking see the widened camera FOV.
replace 0066192A
replace 00672701
replace 006729D3

# The screen rectangles the main window is created with and pinned to
# (src/window.cpp): the host desktop.
replace 0043A408
replace 0043A44B

# Wide resolutions for the options menu (src/resolutions.cpp): the
# system_detail tiers and config:options:video:allowed_res.
replace 0051E28C
replace 00496307

# UI scale (src/ui_scale.cpp): the shell's screen size, update and draws,
# Rapi's DrawPrimitive for the scaled 2D quads, the software cursor.
replace 006DE255
replace 006DFFF7
replace 006E02B8
replace 006E046C
replace 006E0592
replace 00654160
replace 0066A28F
replace 00656D49
replace 0043CB2E

# Software cursor on the GPU (src/cursor.cpp): the cursor draw, its Blt
# helper and its blend.
replace 00656E02
replace 006576EA
replace 0065780F

# The VC6 CRT's string, memory and integer helpers (src/crt.cpp).
replace 0040C8D0 memset
replace 0040C930 memcpy
replace 0040D130 memmove
replace 00631C10 memchr
replace 0040CC70 strlen
replace 0040C7E0 strcpy
replace 0040C7F0 strcat
replace 0040DA70 strncpy
replace 00632090 strncat
replace 00410580 strcmp
replace 0040D7E0 strncmp
replace 0040D6A0 strchr
replace 00631BE0 strrchr
replace 0040D760 strstr
replace 00410610 strcspn
replace 00410650 strpbrk
replace 00409DAE wcslen
replace 00632024 wcscpy
replace 0071EB34 wcsncpy
replace 00631E9E wcschr
replace 00632049 wcsrchr
replace 00631D84 wcscspn
replace 00411C30 _allmul
replace 0040E0D0 _aulldiv
replace 0040E140 _aullrem
replace 00637090 _allshl
replace 0040D820 _alloca_probe
replace 00631810 _ftol

# The CRT's locale-dependent functions (src/crt.cpp).
replace 0040C12D tolower
replace 0040F54D toupper
replace 00411680 _strcmpi
replace 00411750 _strnicmp
replace 006322F0 _memicmp
replace 00631420 _strlwr
replace 00631554 _strupr
replace 00631688 isalpha
replace 006316B6 isdigit
replace 006316DE isspace
replace 00631706 isalnum
replace 00631734 iscntrl
replace 0040C0B8 _isctype

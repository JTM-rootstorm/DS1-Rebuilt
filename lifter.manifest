# ds1_lift manifest: per-binary overrides for DungeonSiege.exe
# (GOG 1.11.1.1486, SHA-256 41f14b14...938a02). Line based:
#
#   entry <hexva> [name]   extra function entry point
#   name  <hexva> <name>   name a function (comments in generated code)
#   probe <hexva> [name]   call ds1::Probe() on entry (runtime logs it)
#   resume <hexva>         this call/jmp abandons the current call chain
#                          (SEH): throw GuestResume to the owning frame
#   replace <hexva> [name] src/ defines f_<VA>; the lifted body becomes
#                          f_<VA>_lifted
#   native <hexva> <name>  a shared native function of SwARc's
#                          (recomp::native::<name>) replaces it
#
# Addresses are guest VAs in hex, no 0x prefix needed.

name  004023DD WinMain
probe 004023DD WinMain

# SEH: __except_handler3 (0040A020) *calls* the __except block, which starts
# with `mov esp, [ebp-18h]` and never returns. Resume instead of calling.
name   0040A020 __except_handler3
name   00409F28 _global_unwind2
resume 0040A0A3

# Hor+ field of view (src/fov.cpp): the camera update, the drag-selection
# volume and mouse picking see the widened camera FOV.
replace 0066192A
replace 00672701
replace 006729D3

# World frustums widened with it (src/world_frustum.cpp): SiegeFrustum's
# SetDimensions.
replace 006804BA

# The screen rectangles the main window is created with and pinned to
# (src/window.cpp): the host desktop.
replace 0043A408
replace 0043A44B

# Wide resolutions for the options menu (src/resolutions.cpp): the
# system_detail tiers and config:options:video:allowed_res.
replace 0051E28C
replace 00496307

# UI scale (src/ui_scale.cpp): the shell's screen size, update and draws,
# Rapi's DrawPrimitive for the scaled 2D quads, the software cursor.
replace 006DE255
replace 006DFFF7
replace 006E02B8
replace 006E046C
replace 006E0592
replace 00654160
replace 0066A28F
replace 00656D49
replace 0043CB2E

# Software cursor on the GPU (src/cursor.cpp): the cursor draw, its Blt
# helper and its blend.
replace 00656E02
replace 006576EA
replace 0065780F

# The VC6 CRT's string, memory and integer helpers (SwARc's msvc_crt).
native 0040C8D0 msvc_crt::memset
native 0040C930 msvc_crt::memcpy
native 0040D130 msvc_crt::memmove
native 00631C10 msvc_crt::memchr
native 0040CC70 msvc_crt::strlen
native 0040C7E0 msvc_crt::strcpy
native 0040C7F0 msvc_crt::strcat
native 0040DA70 msvc_crt::strncpy
native 00632090 msvc_crt::strncat
native 00410580 msvc_crt::strcmp
native 0040D7E0 msvc_crt::strncmp
native 0040D6A0 msvc_crt::strchr
native 00631BE0 msvc_crt::strrchr
native 0040D760 msvc_crt::strstr
native 00410610 msvc_crt::strcspn
native 00410650 msvc_crt::strpbrk
native 00409DAE msvc_crt::wcslen
native 00632024 msvc_crt::wcscpy
native 0071EB34 msvc_crt::wcsncpy
native 00631E9E msvc_crt::wcschr
native 00632049 msvc_crt::wcsrchr
native 00631D84 msvc_crt::wcscspn
native 00411C30 msvc_crt::_allmul
native 0040E0D0 msvc_crt::_aulldiv
native 0040E140 msvc_crt::_aullrem
native 00637090 msvc_crt::_allshl
native 0040D820 msvc_crt::_alloca_probe
native 00631810 msvc_crt::_ftol

# The CRT's locale-dependent functions (SwARc's msvc_crt::vc6, on the
# locale globals src/main.cpp gives it).
native 0040C12D msvc_crt::vc6::tolower
native 0040F54D msvc_crt::vc6::toupper
native 00411680 msvc_crt::vc6::_strcmpi
native 00411750 msvc_crt::vc6::_strnicmp
native 006322F0 msvc_crt::vc6::_memicmp
native 00631420 msvc_crt::vc6::_strlwr
native 00631554 msvc_crt::vc6::_strupr
native 00631688 msvc_crt::vc6::isalpha
native 006316B6 msvc_crt::vc6::isdigit
native 006316DE msvc_crt::vc6::isspace
native 00631706 msvc_crt::vc6::isalnum
native 00631734 msvc_crt::vc6::iscntrl
native 0040C0B8 msvc_crt::vc6::_isctype
native 004118DC msvc_crt::vc6::atoi
native 00411851 msvc_crt::vc6::atol
native 0040D465 msvc_crt::vc6::strtol

# VC6's floor and ceil, and the intrinsics _CIpow and _CIfmod (x87 state
# as theirs).
native 006323E1 msvc_crt::vc6::floor
native 00631CB5 msvc_crt::vc6::ceil
native 006324B0 msvc_crt::vc6::_CIpow
native 006326DA msvc_crt::vc6::_CIfmod

# VC6's printf engines, narrow and wide (string streams natively; files go
# to the original).
native 0040B596 msvc_crt::vc6::_output
native 006330D6 msvc_crt::vc6::_woutput
